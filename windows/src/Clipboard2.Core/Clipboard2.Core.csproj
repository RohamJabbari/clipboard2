<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-independent logic: history store, dedupe, retention, search, transforms,
       snippets, AI clients. Unit-tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Clipboard2.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    <!-- Ed25519 for the signed update feed (the BCL has no Ed25519). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clipboard2.Core.Tests" />
  </ItemGroup>
</Project>
